FLASK_ENV=development
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
# Si se deja vacia, la aplicacion genera una automaticamente al iniciar
SECRET_KEY=

# PostgreSQL (recomendado para producción)
# Crear la BD: CREATE DATABASE gestion_visitas;
# Formato: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql://sgrv:tu_contrasena@localhost:5432/gestion_visitas
# Alternativa para desarrollo sin servidor (SQLite):
# DATABASE_URL=sqlite:///database/gestion_visitas.db

# Tunel de Cloudflare (URL publica temporal)
# 1 = activado (por defecto), 0 = desactivado
CLOUDFLARE_TUNNEL=1

# Configuracion de Correo (cPanel - SGRV soporte)
# Servidor: sgrv.azconsultingperu.com | Puerto 465 SSL (recomendado) o 587 TLS
# La contraseña real va solo en .env (no se commitea). Ver .gitignore.
MAIL_SERVER=sgrv.azconsultingperu.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=soporte@sgrv.azconsultingperu.com
MAIL_PASSWORD=tu_contrasena_cpanel_aqui
MAIL_DEFAULT_SENDER=soporte@sgrv.azconsultingperu.com
MAIL_SENDER_NAME=SGRV – IESTP Paiján
NOTIFY_EMAIL=soporte@sgrv.azconsultingperu.com

# Alternativa Gmail (desarrollo local con App Password)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_SSL=False
# MAIL_USE_TLS=True
# MAIL_USERNAME=azconsultingperu@gmail.com
# MAIL_PASSWORD=tu_contrasena_de_aplicacion_gmail
# MAIL_DEFAULT_SENDER=azconsultingperu@gmail.com

# DX: desactiva rate limit de /auth/recuperar solo en dev/testing (nunca en prod)
# Útil para pruebas repetidas sin esperar 15 min. No lo actives en producción.
# DISABLE_RATE_LIMIT=true
